FROM golang:1.26-bookworm@sha256:6c5605ab3a9a9fb3c4eafe5b3d63cdbf3881caf113262b67862547b54a9db599 AS builder

WORKDIR /source

COPY go.mod go.sum ./
RUN go mod download

COPY agent ./agent
COPY protocol ./protocol

RUN mkdir -p /out \
    && CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" -o /out/tempo-agent ./agent/cmd/tempo-agent \
    && CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" -o /out/tempo-agent-configure ./agent/cmd/tempo-agent-configure \
    && CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" -o /out/compasso-session-logout ./agent/cmd/compasso-session-logout \
    && CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" -o /out/tempo-pam-check ./agent/cmd/tempo-pam-check \
    && CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" -o /out/tempo-pam-setup ./agent/cmd/tempo-pam-setup

FROM scratch AS exported-binaries

COPY --from=builder /out/ /
