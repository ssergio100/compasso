[Unit]
Description=Compasso local time-control agent
Wants=systemd-logind.service dbus.service
After=local-fs.target systemd-logind.service dbus.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/sbin/tempo-agent -config /etc/tempo-agent/config.toml
Restart=on-failure
RestartSec=2s
StateDirectory=tempo-agent
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
