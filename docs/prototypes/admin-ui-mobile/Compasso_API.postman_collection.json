    {
      "name": "11 - Device / Agent Heartbeat",
      "description": "Endpoints usados pelo agente Linux. Exigem device_id + Bearer token. Máximo de 100 events e 100 command_acks por heartbeat.",
      "item": [
        {
          "name": "POST Heartbeat - Minimal / Inactive Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Tempo-Device-ID",
                "value": "{{device_id}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/device/heartbeat",
            "description": "Heartbeat mínimo sem sessão gráfica ativa.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy_revision\": {{policy_revision}},\n  \"control_revision\": {{control_revision}},\n  \"session_state_revision\": {{session_state_revision}},\n  \"local_date\": \"{{local_date}}\",\n  \"seconds_used\": 0,\n  \"graphical_session_active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date();",
                  "const yyyy = d.getFullYear();",
                  "const mm = String(d.getMonth() + 1).padStart(2, '0');",
                  "const dd = String(d.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('local_date', `${yyyy}-${mm}-${dd}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "if (data.control && typeof data.control.revision !== 'undefined') pm.collectionVariables.set('control_revision', String(data.control.revision));",
                  "if (data.policy && typeof data.policy.revision !== 'undefined') {",
                  "  pm.collectionVariables.set('policy_revision', String(data.policy.revision));",
                  "}",
                  "if (data.session_state && typeof data.session_state.revision !== 'undefined') {",
                  "  pm.collectionVariables.set('session_state_revision', String(data.session_state.revision));",
                  "}",
                  "if (Array.isArray(data.commands) && data.commands.length > 0 && data.commands[0].id) {",
                  "  pm.collectionVariables.set('command_id', data.commands[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
