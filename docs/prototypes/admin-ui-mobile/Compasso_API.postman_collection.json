  "item": [
    {
      "name": "00 - Saúde",
      "item": [
        {
          "name": "GET Healthcheck",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/healthz",
            "description": "Healthcheck público. Resposta esperada: {\"status\":\"ok\"}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Setup inicial (somente primeira instalação)",
      "description": "Use apenas se `setup_required` vier como true. Depois que existir um administrador, o setup retorna conflito.",
      "item": [
        {
          "name": "GET Admin Session / Bootstrap CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/admin/session",
            "description": "Cria o cookie temporário de CSRF de login/setup e devolve `csrf_token` e `setup_required`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "if (data.csrf_token) {",
                  "  pm.collectionVariables.set('login_csrf_token', data.csrf_token);",
                  "  if (data.authenticated) pm.collectionVariables.set('csrf_token', data.csrf_token);",
                  "}",
                  "if (typeof data.setup_required !== 'undefined') {",
                  "  pm.collectionVariables.set('setup_required', String(data.setup_required));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Setup inicial",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/admin/setup",
            "description": "Cria o primeiro administrador e já inicia a sessão. Só funciona quando ainda não existe administrador.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{setup_login}}\",\n  \"password\": \"{{setup_password}}\",\n  \"password_confirmation\": \"{{setup_password}}\",\n  \"csrf_token\": \"{{login_csrf_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login/setup succeeded', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const data = pm.response.json();",
                  "if (data.csrf_token) pm.collectionVariables.set('csrf_token', data.csrf_token);",
                  "if (data.login) pm.collectionVariables.set('authenticated_login', data.login);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Sessão administrativa",
      "item": [
        {
          "name": "GET Admin Session / Bootstrap CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/admin/session",
            "description": "Se não autenticado, cria o CSRF temporário para login. Se autenticado, devolve o CSRF da sessão."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "if (data.csrf_token) {",
                  "  pm.collectionVariables.set('login_csrf_token', data.csrf_token);",
                  "  if (data.authenticated) pm.collectionVariables.set('csrf_token', data.csrf_token);",
                  "}",
                  "if (typeof data.setup_required !== 'undefined') {",
                  "  pm.collectionVariables.set('setup_required', String(data.setup_required));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/admin/session",
            "description": "Autentica o administrador. O Postman armazena o cookie de sessão automaticamente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{admin_login}}\",\n  \"password\": \"{{admin_password}}\",\n  \"csrf_token\": \"{{login_csrf_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login/setup succeeded', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const data = pm.response.json();",
                  "if (data.csrf_token) pm.collectionVariables.set('csrf_token', data.csrf_token);",
                  "if (data.login) pm.collectionVariables.set('authenticated_login', data.login);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Sessão atual",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/admin/session",
            "description": "Confirma a sessão atual e atualiza `csrf_token`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "if (data.csrf_token) pm.collectionVariables.set('csrf_token', data.csrf_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE Logout",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/admin/session",
            "description": "Encerra a sessão administrativa atual. Esperado: HTTP 204."
          },
          "event": [
            {
              "listen": "test",
