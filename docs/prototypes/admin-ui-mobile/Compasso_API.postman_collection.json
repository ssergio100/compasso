    {
      "name": "04 - Policy",
      "description": "O array `weekly_quota_seconds` contém 7 valores em segundos. O servidor limita cada dia a 0..86400 e warning_minutes a 0..120.",
      "item": [
        {
          "name": "PUT Policy / Quotas",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/admin/devices/{{device_id}}/policy",
            "description": "Atualiza cotas semanais e minutos de aviso. Cada quota deve estar entre 0 e 86400 segundos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weekly_quota_seconds\": [\n    7200,\n    7200,\n    7200,\n    7200,\n    7200,\n    7200,\n    7200\n  ],\n  \"warning_minutes\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
